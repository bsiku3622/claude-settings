# Allow-list approach: ignore all Codex runtime state, then share only config.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/LICENSE
!/config.toml
!/writing-style.md
!/hooks.json
!/hooks/
!/rules/
!/skills/

# Lifecycle hooks.
hooks/*
!hooks/*.sh

# Command approval rules.
rules/*
!rules/*.rules

# Personal skills only; bundled and plugin skills stay local.
skills/*
!skills/brief/
!skills/discuss/
!skills/discuss-done/
!skills/explain/
!skills/funky-ui/
!skills/frontend-design/
!skills/save-report/
!skills/studio-baeks-ppt/
!skills/myformats-latex/

skills/*/*
!skills/*/SKILL.md
!skills/*/agents/

!skills/myformats-latex/assets/
!skills/myformats-latex/assets/template.tex

skills/*/agents/*
!skills/*/agents/openai.yaml

# OS / editor noise.
.DS_Store

# Preserve the imported frontend-design license.
!skills/frontend-design/LICENSE.txt
