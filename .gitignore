# Allow-list approach: ignore everything, then unignore what we share.
/*
!/.gitignore
!/CLAUDE.md
!/language-style.md
!/writing-style.md
!/settings.json
!/skills/
!/hooks/
!README.md
!LICENSE

# Inside hooks/, keep scripts only.
hooks/*
!hooks/*.sh
!hooks/*.ps1


# Never commit local settings overrides.
settings.local.json

# OS / editor noise
.DS_Store
